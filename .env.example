# Les variables d'environnement de DossierBC. À copier dans Vercel (Settings > Environment
# Variables), JAMAIS dans le dépôt : ce fichier ne contient que des noms et des exemples.
#
# Le site AFFICHE tout sans aucune de ces variables : les pages et les données sont fabriquées
# d'avance et committées. Elles ne servent qu'aux fonctions api/ et au robot.

# --- Indispensables pour les formulaires (« Représentez votre ville », « Nous écrire ») --------
# Resend : l'envoi des courriels.
RESEND_API_KEY=re_...
# L'adresse d'expédition, sur un domaine vérifié chez Resend.
DIGEST_FROM=DossierBC <bonjour@dossierbc.ca>
# Où arrivent les messages et les demandes de ville. Plusieurs adresses : séparées par une virgule.
MESSAGES_A=mart.archambault@gmail.com

# --- Le compte (connexion par lien magique, suivis, « Demander une explication ») -------------
# Le projet Supabase de DossierQuébec — le MÊME pour toute la famille Dossier. Les tables de la
# C.-B. y sont à part, préfixées bc_ : voir scripts/supabase-colombie-britannique.sql.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
# La clé PUBLIQUE (sb_publishable_…) n'est pas ici : elle est dans commun/dq.js, et c'est normal —
# elle est faite pour être lue par le navigateur, et la RLS est ce qui protège les données.

# --- Facultatif --------------------------------------------------------------------------------
# Signature des appels de tâches planifiées (flux, envois) : à poser si un cron est branché.
CRON_SECRET=...
# L'adresse publique du site, quand une fonction doit fabriquer un lien absolu.
PUBLIC_SITE_URL=https://dossierbc.ca

# --- Le robot du lundi (GitHub Actions, pas Vercel) --------------------------------------------
# Dans le dépôt : Settings > Secrets and variables > Actions > New repository secret.
# Les résumés en langage clair ne sont pas activés pour l'instant : sans cette clé, tout le reste
# du rafraîchissement tourne quand même.
ANTHROPIC_API_KEY=sk-ant-...
